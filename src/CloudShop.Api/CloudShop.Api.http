
@CloudShop.Api_HostAddress = http://localhost:5016

POST {{CloudShop.Api_HostAddress}}/products
Content-Type: application/json

{
  "name": "Test Product",
  "description": "Testing domain validation",
  "price": -500,
  "stockQuantity": 10
}

### Get all products

GET {{CloudShop.Api_HostAddress}}/products
Accept: application/json

### Get product by ID

GET {{CloudShop.Api_HostAddress}}/products/6B306A1F-EEC-46EF-929B-70AE0C44B0B8
Accept: application/json

### Update product price

PUT {{CloudShop.Api_HostAddress}}/products/27ED20CA-B585-47FA-A49F-3603B10FB505/price
Content-Type: application/json

{
  "newPrice": -3099.99
}